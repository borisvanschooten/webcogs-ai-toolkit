{
  "name": "webcogs-ai-toolkit",
  "publisher": "borisvanschooten",
  "displayName": "WebCogs AI Toolkit",
  "description": "Experimental AI LLM-as-compiler toolkit",
  "categories": ["AI", "Programming Languages"],
  "keywords": ["prompts as code", "context engineering", "code generation", "LLM" ],
  "icon": "head-with-cog-crop-right-128x128.png",
  "repository": "https://github.com/borisvanschooten/webcogs-ai-toolkit",
  "version": "0.8.0",
  "license": "MIT",
  "engines": {
    "vscode": "^1.102.0"
  },
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "title": "Enable Webcogs CodeLens",
        "command": "webcogs.enableCodeLens",
        "category": "Webcogs"
      },
      {
        "title": "Disable Webcogs CodeLens",
        "command": "webcogs.disableCodeLens",
        "category": "Webcogs"
      },
      {
        "title": "Re-enter Webcogs OpenAI API key",
        "command": "webcogs.enterOpenAIAPiKey",
        "category": "Webcogs"
      }
    ],
    "configuration": {
      "properties": {
        "webcogs.enableCodeLens": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "webcogsContainer",
          "title": "Webcogs",
          "icon": "head-with-cog-crop-right-24x24.png"
        }
      ]
    },
    "views": {
      "webcogsContainer": [
        {
          "id": "webcogsSimpleListView",
          "name": "Specification Assessment",
          "icon": "head-with-cog-crop-right-128x128.png"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "webcogsSimpleListView",
       "contents": "Assessment of your specifications is shown here when buiding or assessing @cogs_func functions."
      }
    ]
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test",
    "install-local-webcogs": "cd ../.. && npm run pack && cd vscode-extension/webcogs/ && npm install ../../webcogs-0.8.0.tgz --no-save",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.102.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "20.x",
    "eslint": "^9.25.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
